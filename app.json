{
  "expo": {
    "name": "ngaren-connect-mobile",
    "slug": "ngarendigital",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ngarenconnectmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.emaanidev.ngarenconnectmobile",
      "versionCode": 19
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withAndroidBuildFixes",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 160,
            "backgroundColor": "#FFFFFF"
          }
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#6D874F"
        }
      ],
      "expo-background-task",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ngaren needs access to your photos to attach an animal picture.",
          "cameraPermission": "Ngaren needs camera access to photograph an animal or scan a tag."
        }
      ],
      "expo-sharing",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Ngaren uses your location to centre the herd map on where you are."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e12d6253-e833-4df1-ab0e-7dd6108c0cfa"
      }
    },
    "owner": "ngarens-team"
  }
}
